.terraform/
*.tfstate
*.tfstate.backup
*.tfplan
*.snap

# .terraform.lock.hcl is deliberately NOT ignored — it is committed. It
# pins provider versions and records their checksums, so CI can't be
# broken by an upstream release and a substituted provider can't install
# silently. Regenerate with `terraform providers lock` (see
# docs/deployment.md), never by hand.
.DS_Store

# Vault rotation script state (accessors only, not secrets — but keep out of the repo)
.vault-rotation-state/

# Local development TLS material, generated by scripts/generate-dev-certs.sh.
# Private keys must never be committed — a key in version control is
# compromised from the moment it lands, whether or not anyone notices.
docker/dev/tls/
