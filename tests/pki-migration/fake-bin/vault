#!/usr/bin/env bash
# Stand-in for the vault CLI, for the migration driver's tests.
set -uo pipefail
printf 'vault %s\n' "$*" >> "${FAKE_LOG}"

if [[ "$*" == *"raft list-peers"* ]]; then
    n="${FAKE_VOTERS:-3}"
    # FAKE_VOTERS_DROP_AFTER models a node falling out of the cluster
    # partway through a run: the first N calls report a full cluster,
    # every call after that reports one fewer. Without this the gate's
    # voter check can only ever compare a constant against itself.
    if [[ -n "${FAKE_VOTERS_DROP_AFTER:-}" ]]; then
        c="${FAKE_LOG}.votercalls"
        printf 'x' >> "$c"
        if [[ "$(wc -c < "$c" | tr -d '[:space:]')" -gt "$FAKE_VOTERS_DROP_AFTER" ]]; then
            n=$((n - 1))
        fi
    fi
    python3 - "$n" <<'PY'
import json, sys
n = int(sys.argv[1])
servers = [{"node_id": f"vault-{i}", "voter": True} for i in range(n)]
print(json.dumps({"data": {"config": {"servers": servers}}}))
PY
    exit 0
fi

# vault read -field=certificate pki/cert/ca
if [[ "$*" == *"/cert/ca"* ]]; then
    [[ "${FAKE_PKI_READY:-true}" == "true" ]] || exit 2
    cat "${FIXTURES}/pkica.crt"
    exit 0
fi

# vault write <mount>/issue/<role> ... -- the test issue the driver does
# before installing anything, to find out whether the role will sign what
# each node currently serves.
#
# FAKE_ROLE_REFUSES is a space-separated list of names the role rejects,
# and the shim reports them the way Vault does, one per refused name. A
# boolean would only prove the driver stops; the useful assertion is which
# name it hands back to the operator.
if [[ "$*" == *"/issue/"* ]]; then
    refused=""
    for name in ${FAKE_ROLE_REFUSES:-}; do
        [[ "$*" == *"${name}"* ]] && refused="${refused}${name} "
    done
    if [[ -n "$refused" ]]; then
        echo "Error writing data to pki/issue/vault-node: Error making API request." >&2
        echo "" >&2
        echo "Code: 400. Errors:" >&2
        echo "" >&2
        for name in $refused; do
            echo "* subject alternate name ${name} not allowed by this role" >&2
        done
        exit 2
    fi
    printf '{"data":{"certificate":"-----BEGIN CERTIFICATE-----\\nfake\\n-----END CERTIFICATE-----"'
    # ${VAR-d}, not ${VAR:-d}: an empty FAKE_ISSUE_SERIAL is a response
    # carrying no usable serial, which is a case the driver has to report.
    printf ',"serial_number":"%s"}}\n' "${FAKE_ISSUE_SERIAL-3f:9c:12:aa:7b:04:e1:55}"
    exit 0
fi

# vault write <mount>/revoke serial_number=... -- undoing a test issue.
# The role has no no_store, so an unrevoked one stays in storage for its
# whole TTL. FAKE_REVOKE_RC models the revoke failing, which has to warn
# rather than abort: the check it belongs to has already answered.
if [[ "$*" == *"/revoke"* ]]; then
    if [[ "${FAKE_REVOKE_RC:-0}" != "0" ]]; then
        echo "Error writing data to pki/revoke: Error making API request." >&2
        exit "${FAKE_REVOKE_RC}"
    fi
    printf '{"data":{"revocation_time":1759276800}}\n'
    exit 0
fi

echo "fake vault: unhandled command: $*" >&2
exit 64
