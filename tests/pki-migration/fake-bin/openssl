#!/usr/bin/env bash
# Stand-in for openssl, so a node's *served* issuer is controllable.
#
# FAKE_NODE_ISSUERS maps node address -> issuer, e.g.
#   "127.0.0.1:8200=pki,127.0.0.1:8210=bootstrap"
# Anything not listed defaults to FAKE_DEFAULT_ISSUER.
set -uo pipefail

REAL_OPENSSL="${FAKE_REAL_OPENSSL:-/usr/bin/openssl}"

# The migration script pipes `s_client` into `x509 -noout -issuer`. The
# connect address is what identifies the node, so it is recorded and the
# issuer decided here; x509 then just echoes what s_client produced.
if [[ "${1:-}" == "s_client" ]]; then
    addr=""
    for ((i = 1; i <= $#; i++)); do
        if [[ "${!i}" == "-connect" ]]; then
            j=$((i + 1)); addr="${!j}"
        fi
    done
    printf 'connect %s\n' "$addr" >> "${FAKE_LOG}"

    issuer="${FAKE_DEFAULT_ISSUER:-pki}"
    for pair in ${FAKE_NODE_ISSUERS//,/ }; do
        [[ "${pair%%=*}" == "$addr" ]] && issuer="${pair#*=}"
    done

    # The driver compares a node's served issuer against the subject it
    # reads off the fixture CA using the real openssl. Never hardcode that
    # DN here: openssl renders it differently between builds -- 3.0 prints
    # "CN = vault pki CA" and others print "CN=vault pki CA" -- so a
    # literal matches on the machine it was written on and nowhere else.
    # It arrives in FAKE_PKI_ISSUER, read from the fixture by the same
    # binary the driver will use.
    # Two consumers now: the issuer read, and the SAN read. Both are fed
    # from this one s_client, so it emits the address as well -- the SAN
    # branch has no other way to know which node it is describing.
    case "$issuer" in
        pki)       printf 'ISSUER:%s\n' "${FAKE_PKI_ISSUER:?FAKE_PKI_ISSUER is not set}" ;;
        bootstrap) printf 'ISSUER:CN=a bootstrap CA, not the pki fixture\n' ;;
        none)      : ;;
    esac
    printf 'ADDR:%s\n' "$addr"
    exit 0
fi

# x509 -ext subjectAltName reading from stdin. The driver reads each
# node's SANs off the wire to carry them onto the new certificate, so the
# shim has to have some -- and they have to be per node, because the whole
# reason the driver carries them rather than inventing them is that the
# profiles disagree about which ones matter.
#
# FAKE_NODE_SANS maps address -> a `|`-separated SAN list, space
# separated between nodes, e.g.
#   "127.0.0.1:8200=DNS:vault-0|IP:127.0.0.1 127.0.0.1:8210=DNS:vault-1"
# Anything unlisted gets FAKE_DEFAULT_SANS.
if [[ "${1:-}" == "x509" && "$*" == *"subjectAltName"* ]]; then
    marker="$(cat)"
    addr="$(sed -n 's/^ADDR://p' <<< "$marker" | head -1)"
    sans="${FAKE_DEFAULT_SANS:-DNS:localhost|IP:127.0.0.1}"
    for pair in ${FAKE_NODE_SANS:-}; do
        [[ "${pair%%=*}" == "$addr" ]] && sans="${pair#*=}"
    done
    # openssl spells an address SAN "IP Address:", not "IP:". The knob
    # uses the short form because a test should be readable; the rendering
    # is the real one, because the driver parses what openssl prints.
    printf 'X509v3 Subject Alternative Name: \n'
    printf '    %s\n' "$(printf '%s' "$sans" \
        | tr '|' ',' | sed -e 's/,/, /g' -e 's/IP:/IP Address:/g')"
    exit 0
fi

# x509 reading from stdin: pass the marker through as an issuer line.
if [[ "${1:-}" == "x509" && "$*" == *"-issuer"* ]]; then
    line="$(cat)"
    [[ -z "$line" ]] && exit 1
    printf 'issuer=%s\n' "${line#ISSUER:}"
    exit 0
fi

# Anything else (reading the CA fixture for its subject) is real.
exec "$REAL_OPENSSL" "$@"
