#!/usr/bin/env bash
# Stand-in for the az CLI. Records every invocation and behaves like
# `az network bastion tunnel`: it opens a local listener and keeps running
# until killed.
#
# Modelled on what the real command does, not on what the script wants:
# the tunnel is a long-lived process holding a port, which is the entire
# reason scripts/bastion-proxy.sh exists rather than a plain ProxyCommand.
set -uo pipefail
printf 'az %s\n' "$*" >> "${FAKE_LOG}"

PORT=""
while [[ $# -gt 0 ]]; do
    case "$1" in
        --port) PORT="$2"; shift 2 ;;
        *)      shift ;;
    esac
done

if [[ "${FAKE_TUNNEL_RC:-0}" != "0" ]]; then
    echo "ERROR: (ResourceNotFound) the Bastion host was not found" >&2
    exit "${FAKE_TUNNEL_RC}"
fi

# A tunnel that never listens: the real failure when the Bastion is still
# starting, or the target id names an instance that is gone.
if [[ "${FAKE_TUNNEL_NEVER_LISTENS:-false}" == "true" ]]; then
    sleep 60 &
    wait $!
    exit 0
fi

[[ -n "$PORT" ]] || { echo "no --port given" >&2; exit 64; }

# A cold Bastion does not answer instantly: the session has to be set up
# before anything listens locally. Seconds, not milliseconds, and the
# first connection of a playbook run is the one that pays it.
if [[ "${FAKE_TUNNEL_LISTEN_DELAY:-0}" != "0" ]]; then
    sleep "${FAKE_TUNNEL_LISTEN_DELAY}"
fi

# The trailing arguments are not read. They put "bastion tunnel" on this
# process's command line, which is how the real leaked process is found:
# az's child is `python3 -Im azure.cli network bastion tunnel ...`, while
# a heredoc's would be `python3 -` and invisible to any search for it.
LISTENER_SRC='
import socket, sys, time
s = socket.socket()
s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
s.bind(("127.0.0.1", int(sys.argv[1])))
s.listen(8)
while True:
    try:
        conn, _ = s.accept()
        conn.close()
    except OSError:
        time.sleep(0.05)
'
python3 -c "$LISTENER_SRC" "$PORT" network bastion tunnel --port "$PORT" &
LISTENER=$!

# Deliberately no trap. The real `az` is a shell wrapper around the
# process that holds the tunnel, and killing the wrapper does not kill
# that child -- it keeps the local port and the Bastion session. A shim
# that tidied up on TERM was modelling a better-behaved tool than the one
# in use, and made the leftover count below unfailable.
wait "$LISTENER"
