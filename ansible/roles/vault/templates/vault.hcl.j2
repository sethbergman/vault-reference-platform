cluster_name = "{{ vault_cluster_name }}"

storage "raft" {
  path    = "/opt/vault/data"
  node_id = "{{ inventory_hostname }}"

  # Peers are discovered through the cloud provider's API rather than
  # listed here. Without this block a node comes up healthy and never
  # joins anything — the cluster silently becomes N standalone Vaults,
  # each with its own unseal state, and nothing reports an error.
  #
  # Both clouds are configured from the values
  # scripts/terraform-to-ansible.sh writes out of the Terraform state, so
  # discovery here cannot drift from what Terraform actually built.
{% if vault_cloud == "aws" %}
  # AWS filters on the same EC2 instance tag the dynamic inventory uses
  # (ansible/inventory/aws_ec2.yml), so cluster formation and configuration
  # management break together rather than one drifting from the other.
  retry_join {
    auto_join             = "provider=aws region={{ vault_aws_region }} tag_key={{ vault_cluster_tag.split('=')[0] }} tag_value={{ vault_cluster_tag.split('=')[1] }}"
    auto_join_scheme      = "https"
    leader_tls_servername = "{{ vault_cluster_name }}.vault.internal"
    leader_ca_cert_file   = "{{ vault_tls_dir }}/ca.crt"
  }
{% elif vault_cloud == "azure" %}
  # Azure uses scale-set mode, not tag mode. go-discover accepts
  # (tag_name + tag_value) or (resource_group + vm_scale_set) and rejects
  # a mix with "unclear configuration" — so unlike AWS this cannot filter
  # on the VaultCluster tag. Tag mode would be wrong anyway: it matches
  # tags on network interfaces, not on the VMs Terraform tags.
  #
  # This keeps the Ansible path identical to what cloud-init writes; see
  # terraform/azure/templates/cloud-init.sh.tftpl.
  retry_join {
    auto_join             = "provider=azure subscription_id={{ vault_azure_subscription_id }} resource_group={{ vault_resource_group }} vm_scale_set={{ vault_scale_set_name }}"
    auto_join_scheme      = "https"
    leader_tls_servername = "{{ vault_cluster_name }}.vault.internal"
    leader_ca_cert_file   = "{{ vault_tls_dir }}/ca.crt"
  }
{% endif %}
  #
  # leader_tls_servername is the one name every follower verifies a leader
  # against, whichever node leads; every certificate carries it. cloud-init
  # has always set it and this template never did, so the playbook quietly
  # replaced a config that verified the cluster's name with one verifying
  # an IP -- which works only while certificates carry IP SANs, and stops
  # once Vault's PKI issues them. Seen on the first real apply, in the diff.
}

listener "tcp" {
  address       = "0.0.0.0:8200"
  tls_cert_file = "{{ vault_tls_dir }}/vault.crt"
  tls_key_file  = "{{ vault_tls_dir }}/vault.key"

  # Peers must present a certificate from the same CA, so reaching the
  # network is not enough to attempt joining the cluster.
  tls_client_ca_file = "{{ vault_tls_dir }}/ca.crt"

  tls_min_version = "tls12"

  telemetry {
    unauthenticated_metrics_access = false
  }
}

# Rendered from vault_ui_enabled rather than omitted when the UI is off,
# so the config states the answer either way. An absent setting and an
# explicit opt-out behave identically to Vault, and differ entirely to
# the next person reading the file to find out whether the UI is on.
#
# Filtered through `lower` rather than tested with a conditional: an
# override arriving as the string "false" is truthy to Jinja, so a
# conditional would enable the UI for someone who explicitly asked to
# turn it off. This renders the value instead of branching on it.
#
# Deliberately no literal setting forms in this comment: the tests grep
# the rendered output, and a comment that quotes the line it explains
# satisfies the assertion whether or not the line itself survives.
ui = {{ vault_ui_enabled | lower }}

api_addr     = "https://{{ ansible_default_ipv4.address }}:8200"
cluster_addr = "https://{{ ansible_default_ipv4.address }}:8201"

# Also always in cloud-init and never here: without a retention time
# /v1/sys/metrics has nothing in Prometheus format, so the playbook turned
# off the metrics the monitoring stack scrapes on every node it touched.
telemetry {
  prometheus_retention_time = "24h"
  disable_hostname          = true
}

{% if vault_seal_type == "awskms" %}
# Auto-unseal via AWS KMS. Relies on the instance role for credentials —
# see terraform/aws's vault_autounseal_iam_policy_arn output, which must be
# attached to the Vault nodes' instance profile.
seal "awskms" {
  region     = "{{ vault_awskms_region }}"
  kms_key_id = "{{ vault_awskms_key_id }}"
}
{% elif vault_seal_type == "azurekeyvault" %}
# Auto-unseal via Azure Key Vault. Relies on the VM's managed identity for
# credentials — see terraform/azure's azurerm_key_vault_access_policy,
# which must be granted to the Vault nodes' managed identity.
seal "azurekeyvault" {
  tenant_id  = "{{ vault_azurekeyvault_tenant_id }}"
  vault_name = "{{ vault_azurekeyvault_vault_name }}"
  key_name   = "{{ vault_azurekeyvault_key_name }}"
}
{% endif %}
