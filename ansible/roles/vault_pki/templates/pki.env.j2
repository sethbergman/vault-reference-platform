# Managed by Ansible (roles/vault_pki). Do not edit.
#
# Read by vault-cert-renew.service. Credentials live here rather than on
# the ExecStart line because a command line is world-readable via /proc.

VAULT_ADDR=https://127.0.0.1:8200
VAULT_CACERT={{ vault_tls_dir }}/ca.crt
{% if vault_pki_role_id | length > 0 %}
VAULT_ROLE_ID={{ vault_pki_role_id }}
VAULT_SECRET_ID={{ vault_pki_secret_id }}
{% else %}
VAULT_TOKEN={{ vault_pki_token }}
{% endif %}
