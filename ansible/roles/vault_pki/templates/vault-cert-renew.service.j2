[Unit]
Description=Renew this node's Vault TLS certificate from Vault PKI
Documentation=https://github.com/sethbergman/vault-reference-platform/blob/main/docs/security.md
Requires=vault.service
After=vault.service network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/vault.d/pki.env

# Runs as root: it writes into /etc/vault.d/tls and signals the vault
# unit. The Vault process itself still runs as vault.
User=root

ExecStart={{ vault_pki_script }} \
  --common-name {{ vault_pki_common_name }} \
{% if vault_pki_alt_names | length > 0 %}
  --alt-names {{ vault_pki_alt_names }} \
{% endif %}
  --ip-sans {{ ansible_default_ipv4.address }},127.0.0.1 \
  --mount {{ vault_pki_mount }} \
  --role {{ vault_pki_role }} \
  --tls-dir {{ vault_tls_dir }} \
  --ttl {{ vault_pki_cert_ttl }} \
  --renew-within {{ vault_pki_renew_within_days }}

# SIGHUP reloads the certificate contents from the paths Vault started
# with. No restart, no reseal, no leadership change.
NoNewPrivileges=true
ProtectHome=true
PrivateDevices=true

[Install]
WantedBy=multi-user.target
