# Managed by Ansible (roles/vault_snapshots). Do not edit.
#
# Read by vault-snapshot.service. Credentials live here rather than on
# the ExecStart line because a command line is world-readable via /proc.

VAULT_ADDR=https://127.0.0.1:8200
VAULT_CACERT={{ vault_tls_dir }}/ca.crt
{% if vault_snapshots_role_id | length > 0 %}
VAULT_ROLE_ID={{ vault_snapshots_role_id }}
VAULT_SECRET_ID={{ vault_snapshots_secret_id }}
{% else %}
VAULT_TOKEN={{ vault_snapshots_token }}
{% endif %}
